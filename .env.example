# ---------------------------------------------------------------------------
# Tuition Me — environment
#
# Copy to .env.local for development. Every value here is read on the SERVER;
# there are no NEXT_PUBLIC_* variables, so nothing in this file is ever inlined
# into the browser bundle.
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
# Full MongoDB connection string. Percent-encode any special characters in the
# password (e.g. @ -> %40).
MONGODB_URI=mongodb+srv://user:password@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=tuition-me

# --- Auth.js / NextAuth (required) -----------------------------------------
# Signs and encrypts the session JWT. Rotating it signs everyone out.
# Generate with:  npx auth secret
#            or:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Needed when running behind a proxy that terminates TLS (Fly, Render, Docker
# behind nginx). Vercel sets everything Auth.js needs on its own.
AUTH_TRUST_HOST=true

# Canonical origin. Auth.js derives callback URLs from it; leave unset on
# Vercel, set it for Docker/Fly/Render or a custom domain.
# AUTH_URL=https://tuition-me.example.com

# --- Google sign-in (optional) ---------------------------------------------
# Create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials and add this callback URL:
#   http://localhost:3000/api/auth/callback/google        (development)
#   https://<your-domain>/api/auth/callback/google        (production)
# Leave both blank to disable the "Continue with Google" button entirely —
# email/password sign-in keeps working.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Payments (optional; checkout returns 503 without it) ------------------
STRIPE_SECRET_KEY=
# Stripe CLI: `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# prints this. Without it the webhook endpoint refuses every request.
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# --- Deployment ------------------------------------------------------------
# Public origin, used to build Stripe redirect URLs. On Vercel this is derived
# automatically; set it explicitly for Docker/Fly/Render or a custom domain.
# APP_URL=https://tuition-me.example.com
